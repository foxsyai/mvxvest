            "variants": [
                {
                    "docs": [
                        "Every second, in proportion to the time elapsed since `start`."
                    ],
                    "name": "Linear",
                    "discriminant": 0
                },
                {
                    "docs": [
                        "In equal steps every `interval` seconds from `start`; the last step",
                        "falls on `end`, even when the interval does not divide the duration."
                    ],
                    "name": "Stepped",
                    "discriminant": 1,
                    "fields": [
                        {
                            "name": "interval",
                            "type": "u64"
                        }
                    ]
                },
                {
                    "docs": [
                        "An explicit list of releases, in strictly increasing time, the last one",
                        "at `end`. Their amounts add up to the rest."
                    ],
                    "name": "Tranches",
                    "discriminant": 2,
                    "fields": [
                        {
                            "name": "0",
                            "type": "List<Tranche>"
                        }
                    ]
                }
            ]
        },
        "KeyKind": {
            "type": "enum",
            "docs": [
                "The two kinds of key the contract mints."
            ],
            "variants": [
                {
                    "name": "Claim",
                    "discriminant": 0
                },
                {
                    "name": "Cancel",
                    "discriminant": 1
                }
            ]
        },
        "Limits": {
            "type": "struct",
            "docs": [
                "The contract's fixed limits, so the dApp never hard-codes them."
            ],
            "fields": [
                {
                    "name": "max_tranches",
                    "type": "u64"
                },
                {
                    "name": "max_batch",
                    "type": "u64"
                },
                {
                    "name": "max_batch_cancelable",
                    "type": "u64"
                },
                {
                    "name": "max_label_len",
                    "type": "u64"
                },
                {
                    "name": "max_horizon",
                    "type": "u64"
                },
                {
                    "name": "max_page",
                    "type": "u64"
                }
            ]
        },
        "Schedule": {
            "type": "struct",
            "docs": [
                "When and how a vesting releases its total. Timestamps are in seconds."
            ],
            "fields": [
                {
                    "docs": [
                        "The origin of the curve. May be in the past."
                    ],
                    "name": "start",
                    "type": "u64"
                },
                {
                    "docs": [
                        "Nothing can be claimed before this moment. `start <= cliff <= end`."
                    ],
                    "name": "cliff",
                    "type": "u64"
                },
                {
                    "docs": [
                        "Unlocks at the cliff, on top of what the curve has released by then."
                    ],
                    "name": "cliff_amount",
                    "type": "BigUint"
                },
                {
                    "docs": [
                        "From this moment the whole total has vested."
                    ],
                    "name": "end",
                    "type": "u64"
                },
                {
                    "name": "curve",
                    "type": "Curve"
                }
            ]
        },
        "TokenTotals": {
            "type": "struct",
            "docs": [
                "Running totals per token, so the contract can always show what it owes."
            ],
            "fields": [
                {
                    "name": "deposited",
                    "type": "BigUint"
                },
                {
                    "name": "claimed",
                    "type": "BigUint"
                },
                {
                    "name": "refunded",
                    "type": "BigUint"
                }
            ]
        },
        "Tranche": {
            "type": "struct",
            "docs": [
                "One release of an explicit schedule: `amount` unlocks at `time`."
            ],
            "fields": [
                {
                    "name": "time",
                    "type": "u64"
                },
                {
                    "name": "amount",
                    "type": "BigUint"
                }
            ]
        },
        "Vesting": {
            "type": "struct",
            "docs": [
                "What never changes about a vesting."
            ],
            "fields": [
                {
                    "docs": [
                        "Who created it (the caller of `create` or `createBatch`). Gets the",
                        "cancel key, and the refund if it cancels."
                    ],
                    "name": "creator",
                    "type": "Address"
                },
                {
                    "docs": [
                        "The beneficiary at creation. The claim key may have moved since: only",
                        "its holder can claim."
                    ],
                    "name": "beneficiary",
                    "type": "Address"
                },
                {
                    "docs": [
                        "The vested token: `EGLD-000000` or a fungible ESDT."
                    ],
                    "name": "token",
                    "type": "TokenId"
                },
                {
                    "name": "total",
                    "type": "BigUint"
                },
                {
                    "name": "schedule",
                    "type": "Schedule"
                },
                {
                    "name": "cancelable",
                    "type": "bool"
                },
                {
                    "name": "created_at",
                    "type": "u64"
                },
                {
                    "docs": [
                        "Nonce of the claim key in the claim key collection."
                    ],
                    "name": "claim_nonce",
                    "type": "u64"
                },
                {
                    "docs": [
                        "Nonce of the cancel key, 0 when the vesting cannot be cancelled."
                    ],
                    "name": "cancel_nonce",
                    "type": "u64"
                },
                {
                    "name": "label",
                    "type": "bytes"
                }
            ]
        },
        "VestingView": {
            "type": "struct",
            "docs": [
                "A vesting with its live state, as of `timestamp`."
            ],
            "fields": [
                {
                    "name": "id",
                    "type": "u64"
                },
                {
                    "name": "vesting",
                    "type": "Vesting"
                },
                {
                    "name": "claimed",
                    "type": "BigUint"
                },
                {
                    "docs": [
                        "0 unless cancelled."
                    ],
                    "name": "cancelled_at",
                    "type": "u64"
                },
                {
                    "docs": [
                        "Vested at `timestamp` (frozen at the cancel, if any)."
                    ],
                    "name": "vested",
                    "type": "BigUint"
                },
                {
                    "docs": [
                        "Claimable now: vested minus claimed."
                    ],
                    "name": "claimable",
                    "type": "BigUint"
                },
                {
                    "docs": [
                        "The most the claim key can ever collect: the total, or what had vested",
                        "at the cancel."
                    ],
                    "name": "final_amount",
                    "type": "BigUint"
                },
                {
                    "docs": [
                        "Paid back to whoever cancelled (0 unless cancelled)."
                    ],
                    "name": "refunded",
                    "type": "BigUint"
                },
                {
                    "docs": [
                        "The block timestamp these figures are computed at."
                    ],
                    "name": "timestamp",
                    "type": "u64"
                }
            ]
        }
    }
}
