#!/usr/bin/env bash
# Refuses a commit that stages key material. Enable once per clone:
#   git config core.hooksPath .githooks
# CI runs gitleaks on every push as a second line.
set -euo pipefail

blocked=0
while IFS= read -r -d '' path; do
  name="$(basename "$path")"
  case "$name" in
    .env.example) ;;
    *.pem | *.key | *.keystore | .env | .env.* | *mnemonic* | *keystore*.json | *wallet*.json)
      echo "pre-commit: refusing to commit $path (looks like a key or secrets file)" >&2
      blocked=1
      ;;
  esac
done < <(git diff --cached --name-only -z --diff-filter=ACMR)

# Split so this file does not match its own pattern.
key_pattern='-----BEGIN [A-Z ]*PRIV''ATE KEY|PRIV''ATE KEY for erd1'
if git diff --cached -U0 --diff-filter=ACMR | grep -nE "^\+.*($key_pattern)" >/dev/null; then
  echo "pre-commit: refusing to commit: a staged change contains a private key" >&2
  blocked=1
fi

exit "$blocked"
