              "lastNonce": "0"
            },
            "str:VESTCANCEL-123456": {
              "roles": [
                "ESDTRoleNFTCreate",
                "ESDTRoleNFTBurn"
              ],
              "lastNonce": "0"
            }
          }
        },
        "sc:nonpayable": {
          "nonce": "0",
          "balance": "0",
          "code": "mxsc:../output/mvxvest.mxsc.json",
          "codeMetadata": "0x0500",
          "owner": "address:owner"
        }
      },
      "currentBlockInfo": {
        "blockTimestamp": "1767225600"
      }
    },
