{
  "name": "audit5 AUTH, protocol side on the Go VM: init, upgrade and callBack cannot be called directly; a stranger cannot upgrade; an upgrade with stray arguments is refused and resets nothing; a key twice, two of it, nonce 0, a key with EGLD or FOX, or the wrong kind of key moves nothing; the owner cannot take a key a holder has nor the locked funds, and its fee, pause, display and stamping switches leave a running vesting's claim and cancel untouched; a vesting for a non-payable contract in the same shard is refused whole",
  "steps": [
    {
      "step": "setState",
      "accounts": {
        "address:owner": {
          "nonce": "1",
          "balance": "0"
        },
        "address:creator": {
          "nonce": "1",
          "balance": "10,000",
          "esdt": {
            "str:FOX-a1b2c3": "10,000"
          }
        },
        "address:alice": {
          "nonce": "0",
          "balance": "1,000",
          "esdt": {
            "str:FOX-a1b2c3": "100"
          }
        },
        "address:mallory": {
          "nonce": "0",
          "balance": "1,000",
          "esdt": {
            "str:VESTKEY-123456": "3"
          }
        },
        "sc:mvxvest": {
          "nonce": "0",
          "balance": "0",
          "code": "mxsc:../output/mvxvest.mxsc.json",
          "codeMetadata": "0x0500",
          "owner": "address:owner",
          "storage": {
            "str:claimKey": "str:VESTKEY-123456",
            "str:cancelKey": "str:VESTCANCEL-123456"
