        "gasLimit": "100,000,000",
        "gasPrice": "0",
        "esdtValue": [
          {
            "tokenIdentifier": "str:FOX-a1b2c3",
            "value": "1000"
          }
        ]
      },
      "expect": {
        "status": "0",
        "logs": "*",
        "gas": "*",
        "refund": "*",
        "out": [
          "1"
        ]
      }
    },
