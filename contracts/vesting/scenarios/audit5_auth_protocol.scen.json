        "gasPrice": "0",
        "egldValue": "0"
      },
      "expect": {
        "status": "4",
        "message": "str:invalid function (calling callBack() directly is forbidden)",
        "logs": "*",
        "gas": "*",
        "refund": "*"
      }
    },
