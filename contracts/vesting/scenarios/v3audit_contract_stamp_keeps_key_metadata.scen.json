{
  "name": "V3C-1: a key minted under display A and claimed after the owner set display B must keep A's metadata with A's pictures; on 7361158 the stamp writes B's metadata next to A's pictures",
  "steps": [
    {
      "step": "setState",
      "accounts": {
        "address:owner": { "nonce": "1", "balance": "0" },
        "address:creator": {
          "nonce": "1",
          "balance": "10,000",
          "esdt": { "str:FOX-a1b2c3": "1,000" }
        },
        "address:alice": { "nonce": "0", "balance": "0" },
        "sc:mvxvest": {
          "nonce": "0",
          "balance": "0",
          "code": "mxsc:../output/mvxvest.mxsc.json",
          "codeMetadata": "0x0500",
          "owner": "address:owner",
          "storage": {
            "str:claimKey": "str:VESTKEY-123456",
            "str:cancelKey": "str:VESTCANCEL-123456"
          },
          "esdt": {
            "str:VESTKEY-123456": {
              "roles": ["ESDTRoleNFTCreate", "ESDTRoleNFTBurn", "ESDTRoleNFTUpdate"],
              "lastNonce": "0"
            },
            "str:VESTCANCEL-123456": {
              "roles": ["ESDTRoleNFTCreate", "ESDTRoleNFTBurn"],
              "lastNonce": "0"
            }
          }
        }
      },
      "currentBlockInfo": { "blockTimestamp": "1767225600" }
    },
    {
      "step": "scCall",
      "id": "display-A",
      "tx": {
        "from": "address:owner",
        "to": "sc:mvxvest",
        "function": "setKeyDisplay",
        "arguments": ["u8:0", "str:ipfs://design-A", "str:https://mvxvest.io/nft/claim-key-A.png"],
        "gasLimit": "20,000,000",
        "gasPrice": "0"
      },
      "expect": { "status": "0", "logs": "*", "gas": "*", "refund": "*" }
    },
    {
      "step": "scCall",
      "id": "create-under-A",
      "tx": {
        "from": "address:creator",
        "to": "sc:mvxvest",
        "function": "create",
        "arguments": ["address:alice", "1000", "u64:1767225600|u64:1767225600|biguint:0|u64:1767226600|u8:0", "false", "str:team"],
        "gasLimit": "100,000,000",
        "gasPrice": "0",
        "esdtValue": [{ "tokenIdentifier": "str:FOX-a1b2c3", "value": "1000" }]
      },
      "expect": { "status": "0", "logs": "*", "gas": "*", "refund": "*", "out": ["1"] }
    },
    {
      "step": "scCall",
      "id": "display-B",
      "tx": {
        "from": "address:owner",
        "to": "sc:mvxvest",
        "function": "setKeyDisplay",
        "arguments": ["u8:0", "str:ipfs://design-B", "str:https://mvxvest.io/nft/claim-key-B.png"],
        "gasLimit": "20,000,000",
        "gasPrice": "0"
      },
      "expect": { "status": "0", "logs": "*", "gas": "*", "refund": "*" }
    },
    {
      "step": "setState",
      "currentBlockInfo": { "blockTimestamp": "1767225850" }
    },
    {
      "step": "scCall",
      "id": "claim-after-B",
      "tx": {
        "from": "address:alice",
        "to": "sc:mvxvest",
        "function": "claim",
        "arguments": [],
        "gasLimit": "100,000,000",
        "gasPrice": "0",
        "esdtValue": [{ "tokenIdentifier": "str:VESTKEY-123456", "nonce": "1", "value": "1" }]
      },
      "expect": { "status": "0", "logs": "*", "gas": "*", "refund": "*" }
    },
    {
      "step": "checkState",
      "accounts": {
        "address:alice": {
          "nonce": "*",
          "balance": "*",
          "esdt": {
            "str:FOX-a1b2c3": "250",
            "str:VESTKEY-123456": {
              "instances": [
                {
                  "nonce": "1",
                  "balance": "1",
                  "creator": "sc:mvxvest",
                  "uri": ["str:https://mvxvest.io/nft/claim-key-A.png"],
                  "attributes": "str:tags:mvxvest,vesting;vesting:1;token:FOX-a1b2c3;cancelable:0;claimed:250;metadata:ipfs://design-A"
                }
              ]
            }
          },
          "storage": "*",
          "code": "*"
        },
        "+": ""
      }
    }
  ]
}
