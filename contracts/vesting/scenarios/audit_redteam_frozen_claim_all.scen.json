        "gasLimit": "100,000,000",
        "gasPrice": "0",
        "esdtValue": [{ "tokenIdentifier": "str:EVIL-123456", "value": "1" }]
      },
      "expect": { "status": "0", "logs": "*", "gas": "*", "refund": "*", "out": ["2"] }
    },
    {
      "step": "setState",
      "currentBlockInfo": { "blockTimestamp": "1767226100" }
