      "tx": {
        "from": "address:alice",
        "to": "sc:mvxvest",
        "function": "claim",
        "arguments": [],
        "gasLimit": "100,000,000",
        "gasPrice": "0",
        "esdtValue": [
          {
            "tokenIdentifier": "str:VESTKEY-123456",
            "nonce": "1",
            "value": "1"
          },
          {
            "tokenIdentifier": "str:EGLD-000000",
            "value": "7"
          }
