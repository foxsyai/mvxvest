          {
            "tokenIdentifier": "str:VESTKEY-123456",
            "nonce": "1",
            "value": "1"
          }
        ]
      },
      "expect": {
        "status": "4",
        "message": "str:only cancel keys can be sent",
        "logs": "*",
        "gas": "*",
        "refund": "*"
      }
    },
    {
      "step": "scCall",
