{
  "name": "audit5 PROTO: payment shapes the protocol or the contract must refuse at claim and cancel, on the Go VM. EGLD-000000 mixed among the keys, a stray argument, a cancel key sent to claim and a claim key sent to cancel. Every key stays with its holder and nothing is booked. (The same key twice in one MultiESDTNFTTransfer is refused by the protocol before any transaction exists: the runner stops with 'new NFT data on sender for token VESTKEY-123456', so it cannot be a step here.)",
  "steps": [
    {
      "step": "setState",
      "accounts": {
        "address:owner": {
          "nonce": "1",
          "balance": "0"
        },
        "address:creator": {
          "nonce": "1",
          "balance": "0",
          "esdt": {
            "str:FOX-a1b2c3": "2,000"
          }
        },
        "address:alice": {
          "nonce": "0",
          "balance": "1,000,000"
        },
        "sc:mvxvest": {
          "nonce": "0",
          "balance": "0",
          "code": "mxsc:../output/mvxvest.mxsc.json",
          "codeMetadata": "0x0500",
          "owner": "address:owner",
          "storage": {
            "str:claimKey": "str:VESTKEY-123456",
            "str:cancelKey": "str:VESTCANCEL-123456"
          },
          "esdt": {
            "str:VESTKEY-123456": {
              "roles": [
                "ESDTRoleNFTCreate",
                "ESDTRoleNFTBurn",
                "ESDTRoleNFTUpdate"
              ],
              "lastNonce": "0"
            },
            "str:VESTCANCEL-123456": {
              "roles": [
                "ESDTRoleNFTCreate",
                "ESDTRoleNFTBurn"
              ],
              "lastNonce": "0"
            }
          }
        }
      },
      "currentBlockInfo": {
        "blockTimestamp": "1767225600"
      }
    },
    {
      "step": "scCall",
      "id": "create-1-cancelable",
      "tx": {
        "from": "address:creator",
        "to": "sc:mvxvest",
        "function": "create",
        "arguments": [
          "address:alice",
          "1000",
          "u64:1767225600|u64:1767225600|biguint:0|u64:1767226600|u8:0",
          "true",
          "str:one"
        ],
        "gasLimit": "100,000,000",
        "gasPrice": "0",
        "esdtValue": [
          {
            "tokenIdentifier": "str:FOX-a1b2c3",
            "value": "1000"
          }
        ]
      },
      "expect": {
        "status": "0",
        "logs": "*",
        "gas": "*",
        "refund": "*",
        "out": [
          "1"
        ]
      }
    },
    {
      "step": "scCall",
      "id": "create-2-plain",
      "tx": {
        "from": "address:creator",
        "to": "sc:mvxvest",
        "function": "create",
        "arguments": [
          "address:alice",
          "1000",
          "u64:1767225600|u64:1767225600|biguint:0|u64:1767226600|u8:0",
          "false",
          "str:two"
        ],
        "gasLimit": "100,000,000",
        "gasPrice": "0",
        "esdtValue": [
          {
            "tokenIdentifier": "str:FOX-a1b2c3",
            "value": "1000"
          }
        ]
      },
      "expect": {
        "status": "0",
        "logs": "*",
        "gas": "*",
        "refund": "*",
        "out": [
          "2"
        ]
      }
