      "tx": {
        "from": "address:creator",
        "to": "sc:mvxvest",
        "function": "claim",
        "arguments": [],
        "gasLimit": "100,000,000",
        "gasPrice": "0",
        "esdtValue": [
          {
            "tokenIdentifier": "str:VESTCANCEL-123456",
            "nonce": "1",
            "value": "1"
          }
        ]
      },
      "expect": {
        "status": "4",
        "message": "str:only claim keys can be sent",
        "logs": "*",
        "gas": "*",
        "refund": "*"
      }
    },
    {
      "step": "scCall",
      "id": "egld-value-with-a-claim-key",
      "comment": "plain EGLD value with an ESDT transfer: the Go VM folds it into the multi transfer as EGLD-000000 (live on mainnet since epoch 1575), and the contract refuses it as not a key",
      "tx": {
        "from": "address:alice",
        "to": "sc:mvxvest",
        "function": "claim",
        "arguments": [],
        "gasLimit": "100,000,000",
        "gasPrice": "0",
        "egldValue": "5",
        "esdtValue": [
          {
            "tokenIdentifier": "str:VESTKEY-123456",
            "nonce": "1",
            "value": "1"
          }
        ]
      },
      "expect": {
        "status": "4",
        "message": "str:only claim keys can be sent",
        "logs": "*",
        "gas": "*",
        "refund": "*"
      }
    },
    {
      "step": "scQuery",
      "id": "nothing-claimed-on-1",
      "tx": {
        "to": "sc:mvxvest",
        "function": "getClaimable",
        "arguments": [
          "1"
        ]
      },
      "expect": {
        "out": [
          "500"
        ],
        "status": "0"
      }
    },
    {
