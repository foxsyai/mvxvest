{
  "name": "audit2 red team: the token issuer freezes the owner for its token",
  "steps": [
    {
      "step": "setState",
      "comment": "version 2 with the token fee at 10 bps; the owner's FOX account is frozen by FOX's issuer",
      "accounts": {
        "address:owner": {
          "nonce": "1",
          "balance": "0",
          "esdt": {
            "str:FOX-a1b2c3": {
              "instances": [
                {
                  "nonce": "0",
                  "balance": "1"
                }
              ],
              "frozen": "true"
            }
          }
        },
        "address:creator": {
          "nonce": "1",
          "balance": "0",
          "esdt": {
            "str:FOX-a1b2c3": "1,000,000"
          }
        },
        "address:alice": {
          "nonce": "0",
          "balance": "0"
        },
        "sc:mvxvest": {
          "nonce": "0",
          "balance": "0",
          "code": "mxsc:../output/mvxvest.mxsc.json",
          "codeMetadata": "0x0500",
          "owner": "address:owner",
          "storage": {
            "str:claimKey": "str:VESTKEY-123456",
            "str:cancelKey": "str:VESTCANCEL-123456",
            "str:tokenFeeBps": "10"
          },
          "esdt": {
            "str:VESTKEY-123456": {
              "roles": [
                "ESDTRoleNFTCreate",
                "ESDTRoleNFTBurn"
              ],
              "lastNonce": "0"
            },
            "str:VESTCANCEL-123456": {
              "roles": [
                "ESDTRoleNFTCreate",
                "ESDTRoleNFTBurn"
              ],
              "lastNonce": "0"
            }
          }
        }
      },
      "currentBlockInfo": {
        "blockTimestamp": "1767225600"
      }
    },
    {
      "step": "scCall",
      "id": "FINDING: with the fee on, no FOX vesting can be created: the fee cannot reach the frozen owner",
      "tx": {
        "from": "address:creator",
        "to": "sc:mvxvest",
        "function": "create",
        "arguments": [
          "address:alice",
          "10000",
          "u64:1767225600|u64:1767225600|biguint:0|u64:1767226600|u8:0",
          "false",
          "str:x"
        ],
        "gasLimit": "600,000,000",
        "gasPrice": "0",
        "esdtValue": [
          {
            "tokenIdentifier": "str:FOX-a1b2c3",
            "value": "10010"
          }
        ]
      },
      "expect": {
        "status": "10",
        "message": "str:account is frozen for this esdt token",
        "logs": "*",
        "gas": "*",
        "refund": "*"
      }
    },
    {
      "step": "scCall",
      "id": "the owner turns the fee off",
      "tx": {
        "from": "address:owner",
        "to": "sc:mvxvest",
        "function": "setTokenFee",
        "arguments": [
          "0"
        ],
        "gasLimit": "600,000,000",
        "gasPrice": "0"
      },
      "expect": {
        "status": "0",
        "logs": "*",
        "gas": "*",
        "refund": "*",
        "out": []
      }
    },
    {
      "step": "scCall",
      "id": "now the same creation works: the fee transfer was the only thing in the way",
      "tx": {
        "from": "address:creator",
        "to": "sc:mvxvest",
        "function": "create",
        "arguments": [
          "address:alice",
          "10000",
          "u64:1767225600|u64:1767225600|biguint:0|u64:1767226600|u8:0",
          "false",
          "str:x"
        ],
        "gasLimit": "600,000,000",
        "gasPrice": "0",
        "esdtValue": [
          {
            "tokenIdentifier": "str:FOX-a1b2c3",
            "value": "10000"
          }
        ]
      },
      "expect": {
        "status": "0",
        "logs": "*",
        "gas": "*",
        "refund": "*",
        "out": [
          "1"
        ]
      }
    },
    {
      "step": "scCall",
      "id": "the owner turns the fee back on",
      "tx": {
        "from": "address:owner",
        "to": "sc:mvxvest",
        "function": "setTokenFee",
        "arguments": [
          "10"
        ],
        "gasLimit": "600,000,000",
        "gasPrice": "0"
      },
      "expect": {
        "status": "0",
        "logs": "*",
        "gas": "*",
        "refund": "*",
        "out": []
      }
    },
    {
      "step": "setState",
      "currentBlockInfo": {
        "blockTimestamp": "1767226600"
      }
    },
    {
      "step": "scCall",
      "id": "an existing vesting still claims: claims carry no fee and never touch the owner",
      "tx": {
        "from": "address:alice",
        "to": "sc:mvxvest",
        "function": "claim",
        "arguments": [],
        "gasLimit": "600,000,000",
        "gasPrice": "0",
        "esdtValue": [
          {
            "tokenIdentifier": "str:VESTKEY-123456",
            "nonce": "1",
            "value": "1"
          }
        ]
      },
      "expect": {
        "status": "0",
        "logs": "*",
        "gas": "*",
        "refund": "*",
        "out": []
      }
    },
    {
      "step": "checkState",
      "accounts": {
        "address:alice": {
          "nonce": "*",
          "balance": "*",
          "esdt": {
            "str:FOX-a1b2c3": "10000"
          },
          "storage": {},
          "code": ""
        },
        "address:owner": {
          "nonce": "*",
          "balance": "*",
          "esdt": {
            "str:FOX-a1b2c3": {
              "instances": [
                {
                  "nonce": "0",
                  "balance": "1"
                }
              ],
              "frozen": "true"
            }
          },
          "storage": {},
          "code": ""
        },
        "+": ""
      }
    }
  ]
}