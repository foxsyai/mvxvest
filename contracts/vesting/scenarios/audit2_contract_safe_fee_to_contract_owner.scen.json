{
  "name": "audit 2, safe: the token fee and the EGLD fees reach an owner that is a smart contract payable by smart contracts (as the mainnet multisig is); an owner contract that is not would make every fee-paying creation fail in its own shard (across shards the fee would bounce back as surplus)",
  "steps": [
    {
      "step": "setState",
      "comment": "the owner is a contract (any code; here this very contract as a stand-in for the multisig), upgradeable, readable, payable and payable by smart contracts: 0x0506, the mainnet multisig's flags",
      "accounts": {
        "address:deployer": {
          "nonce": "1",
          "balance": "0"
        },
        "address:creator": {
          "nonce": "1",
          "balance": "1,000,000",
          "esdt": {
            "str:FOX-a1b2c3": "100,000"
          }
        },
        "address:alice": {
          "nonce": "0",
          "balance": "0"
        },
        "sc:ownersc": {
          "nonce": "0",
          "balance": "0",
          "code": "mxsc:../output/mvxvest.mxsc.json",
          "codeMetadata": "0x0506",
          "owner": "address:deployer"
        },
        "sc:mvxvest": {
          "nonce": "0",
          "balance": "0",
          "code": "mxsc:../output/mvxvest.mxsc.json",
          "codeMetadata": "0x0500",
          "owner": "sc:ownersc",
          "storage": {
            "str:claimKey": "str:VESTKEY-123456",
            "str:cancelKey": "str:VESTCANCEL-123456"
          },
          "esdt": {
            "str:VESTKEY-123456": {
              "roles": [
                "ESDTRoleNFTCreate",
                "ESDTRoleNFTBurn"
              ],
              "lastNonce": "0"
            },
            "str:VESTCANCEL-123456": {
              "roles": [
                "ESDTRoleNFTCreate",
                "ESDTRoleNFTBurn"
              ],
              "lastNonce": "0"
            }
          }
        }
      },
      "currentBlockInfo": {
        "blockTimestamp": "1767225600"
      }
    },
    {
      "step": "scCall",
      "id": "owner-contract-sets-the-token-fee",
      "tx": {
        "from": "sc:ownersc",
        "to": "sc:mvxvest",
        "function": "setTokenFee",
        "arguments": [
          "100"
        ],
        "gasLimit": "100,000,000",
        "gasPrice": "0"
      },
      "expect": {
        "status": "0",
        "logs": "*",
        "gas": "*",
        "refund": "*",
        "out": []
      }
    },
    {
      "step": "scCall",
      "id": "owner-contract-sets-the-egld-fee",
      "tx": {
        "from": "sc:ownersc",
        "to": "sc:mvxvest",
        "function": "setFee",
        "arguments": [
          "10"
        ],
        "gasLimit": "100,000,000",
        "gasPrice": "0"
      },
      "expect": {
        "status": "0",
        "logs": "*",
        "gas": "*",
        "refund": "*",
        "out": []
      }
    },
    {
      "step": "scCall",
      "id": "create-fox-fee-lands-in-the-owner-contract",
      "tx": {
        "from": "address:creator",
        "to": "sc:mvxvest",
        "function": "create",
        "arguments": [
          "address:alice",
          "1000",
          "u64:1767225600|u64:1767225600|biguint:0|u64:1767226600|u8:0",
          "false",
          "str:fox"
        ],
        "gasLimit": "100,000,000",
        "gasPrice": "0",
        "esdtValue": [
          {
            "tokenIdentifier": "str:FOX-a1b2c3",
            "value": "1010"
          },
          {
            "tokenIdentifier": "str:EGLD-000000",
            "value": "10"
          }
        ]
      },
      "expect": {
        "status": "0",
        "logs": "*",
        "gas": "*",
        "refund": "*",
        "out": [
          "1"
        ]
      }
    },
    {
      "step": "scCall",
      "id": "create-egld-fee-lands-in-the-owner-contract",
      "tx": {
        "from": "address:creator",
        "to": "sc:mvxvest",
        "function": "create",
        "arguments": [
          "address:alice",
          "1000",
          "u64:1767225600|u64:1767225600|biguint:0|u64:1767226600|u8:0",
          "true",
          "str:egld"
        ],
        "gasLimit": "100,000,000",
        "gasPrice": "0",
        "egldValue": "1020"
      },
      "expect": {
        "status": "0",
        "logs": "*",
        "gas": "*",
        "refund": "*",
        "out": [
          "2"
        ]
      }
    },
    {
      "step": "scCall",
      "id": "owner-contract-collects-the-egld-fees",
      "tx": {
        "from": "sc:ownersc",
        "to": "sc:mvxvest",
        "function": "claimFees",
        "arguments": [],
        "gasLimit": "100,000,000",
        "gasPrice": "0"
      },
      "expect": {
        "status": "0",
        "logs": "*",
        "gas": "*",
        "refund": "*",
        "out": []
      }
    },
    {
      "step": "checkState",
      "comment": "1% of each vesting and both flat fees are in the owner contract; the vesting contract holds exactly the two totals",
      "accounts": {
        "sc:ownersc": {
          "nonce": "*",
          "balance": "30",
          "esdt": {
            "str:FOX-a1b2c3": "10"
          },
          "storage": "*",
          "code": "*"
        },
        "sc:mvxvest": {
          "nonce": "*",
          "balance": "1000",
          "esdt": {
            "str:FOX-a1b2c3": "1000",
            "str:VESTKEY-123456": {
              "roles": [
                "ESDTRoleNFTCreate",
                "ESDTRoleNFTBurn"
              ],
              "lastNonce": "2"
            },
            "str:VESTCANCEL-123456": {
              "roles": [
                "ESDTRoleNFTCreate",
                "ESDTRoleNFTBurn"
              ],
              "lastNonce": "1"
            }
          },
          "storage": "*",
          "code": "*"
        },
        "+": ""
      }
    },
    {
      "step": "scQuery",
      "id": "no-surplus-anywhere",
      "tx": {
        "to": "sc:mvxvest",
        "function": "getSurplus",
        "arguments": [
          "str:FOX-a1b2c3"
        ]
      },
      "expect": {
        "out": [
          "0"
        ]
      }
    },
    {
      "step": "setState",
      "comment": "the same owner contract, now not payable by smart contracts (0x0500): what a wrongly deployed or re-owned multisig would look like",
      "accounts": {
        "sc:ownersc": {
          "nonce": "3",
          "balance": "30",
          "esdt": {
            "str:FOX-a1b2c3": "10"
          },
          "code": "mxsc:../output/mvxvest.mxsc.json",
          "codeMetadata": "0x0500",
          "owner": "address:deployer"
        }
      }
    },
    {
      "step": "scCall",
      "id": "create-fails-when-the-owner-cannot-take-the-fee-in-shard",
      "tx": {
        "from": "address:creator",
        "to": "sc:mvxvest",
        "function": "create",
        "arguments": [
          "address:alice",
          "1000",
          "u64:1767225600|u64:1767225600|biguint:0|u64:1767226600|u8:0",
          "false",
          "str:fox2"
        ],
        "gasLimit": "100,000,000",
        "gasPrice": "0",
        "esdtValue": [
          {
            "tokenIdentifier": "str:FOX-a1b2c3",
            "value": "1010"
          },
          {
            "tokenIdentifier": "str:EGLD-000000",
            "value": "10"
          }
        ]
      },
      "expect": {
        "status": "10",
        "message": "str:sending value to non payable contract",
        "logs": "*",
        "gas": "*",
        "refund": "*"
      }
    },
    {
      "step": "scQuery",
      "id": "nothing-was-created",
      "tx": {
        "to": "sc:mvxvest",
        "function": "getVestingCount",
        "arguments": []
      },
      "expect": {
        "out": [
          "2"
        ]
      }
    },
    {
      "step": "scCall",
      "id": "a-dust-creation-pays-no-fee-and-still-works",
      "comment": "a fee that rounds to zero sends nothing, so the owner's flags do not matter",
      "tx": {
        "from": "address:creator",
        "to": "sc:mvxvest",
        "function": "create",
        "arguments": [
          "address:alice",
          "99",
          "u64:1767225600|u64:1767225600|biguint:0|u64:1767226600|u8:0",
          "false",
          "str:dust"
        ],
        "gasLimit": "100,000,000",
        "gasPrice": "0",
        "esdtValue": [
          {
            "tokenIdentifier": "str:FOX-a1b2c3",
            "value": "99"
          },
          {
            "tokenIdentifier": "str:EGLD-000000",
            "value": "10"
          }
        ]
      },
      "expect": {
        "status": "0",
        "logs": "*",
        "gas": "*",
        "refund": "*",
        "out": [
          "3"
        ]
      }
    },
    {
      "step": "checkState",
      "accounts": {
        "address:creator": {
          "nonce": "*",
          "balance": "998,960",
          "esdt": {
            "str:FOX-a1b2c3": "98,891",
            "str:VESTCANCEL-123456": {
              "instances": [
                {
                  "nonce": "1",
                  "balance": "1",
                  "creator": "sc:mvxvest",
                  "uri": [
                    ""
                  ],
                  "attributes": "str:tags:mvxvest,vesting;vesting:2;token:EGLD-000000;cancelable:1"
                }
              ]
            }
          },
          "storage": {},
          "code": ""
        },
        "sc:ownersc": {
          "nonce": "*",
          "balance": "30",
          "esdt": {
            "str:FOX-a1b2c3": "10"
          },
          "storage": "*",
          "code": "*"
        },
        "+": ""
      }
    }
  ]
}
